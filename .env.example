# ---------------------------------------------------------------------------
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
#   PowerShell :  Copy-Item .env.example .env
#   bash/zsh    :  cp .env.example .env
#
# Toute variable préfixée EXPO_PUBLIC_ est compilée dans le binaire mobile et
# donc lisible par quiconque extrait l'APK. N'y mettez JAMAIS de secret :
# uniquement des clés publiques (la apiKey Firebase est conçue pour cela) et
# des URLs. Les vrais secrets restent côté serveur.
# ---------------------------------------------------------------------------

# --- Plateforme web embarquée dans la WebView -------------------------------
# URL de connexion. L'authentification se fait avec le formulaire email/mot de
# passe de la plateforme : l'app ne gère pas encore les identifiants.
EXPO_PUBLIC_WEB_URL=https://suprem-ia.netlify.app

# Nom affiché sous l'icône.
EXPO_PUBLIC_APP_DISPLAY_NAME=SUPREMIA

# Couleurs de l'interface (bandeau, splash, boutons).
EXPO_PUBLIC_BRAND_COLOR=#0B1220
EXPO_PUBLIC_ACCENT_COLOR=#22C55E

# Hôtes autorisés à rester DANS l'app, en plus du domaine ci-dessus.
# Tout lien vers un autre domaine est ouvert dans le navigateur système :
# ce qui n'est pas listé ici sort donc de l'app automatiquement.
#
# Raison de cette ligne : suprem-ia.netlify.app est protégé par Netlify Edge
# Access. La première requête renvoie un 401 qui redirige vers app.netlify.com
# pour s'authentifier. Si ce domaine n'était pas listé, la connexion se
# ferait dans le navigateur, le cookie de session resterait dans Chrome et
# l'app rebouclerait sur l'écran de connexion sans jamais s'ouvrir.
#
# Si vous retirez la protection Edge Access de votre site Netlify, vous pouvez
# vider cette ligne.
EXPO_PUBLIC_INAPP_HOSTS=app.netlify.com

# --- Phase 2 : app native (à remplir quand l'API sera exposée) --------------
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# --- Broker MQTT : HiveMQ Cloud ---------------------------------------------
# 8884 = MQTT sur WebSocket (wss://) : c'est ce que l'app et le navigateur
#        utilisent, car c'est le seul transport supporté sous React Native.
# 8883 = MQTTS (TLS direct) : réservé aux capteurs ESP et au backend.
EXPO_PUBLIC_MQTT_URL=wss://b7f86ed758d34f50b801c7ca5e52951e.s1.eu.hivemq.cloud:8884/mqtt
EXPO_PUBLIC_MQTT_URL_TLS=mqtts://b7f86ed758d34f50b801c7ca5e52951e.s1.eu.hivemq.cloud:8883

# ⚠️ Ces variables sont EXPO_PUBLIC_ : le mot de passe sera COMPILÉ DANS L'APK et
# extractible par quiconque décompile l'app. Utilisez un compte HiveMQ dédié,
# configuré en lecture seule (subscribe only, aucun droit de publication).
# Voir docs/MQTT_SECURITY.md.
EXPO_PUBLIC_MQTT_USER=
# ⚠️ Guillemets OBLIGATOIRES si le mot de passe contient un # : sans eux, le
# lecteur de .env traite le # comme un début de commentaire et tronque la valeur.
EXPO_PUBLIC_MQTT_PASSWORD=""

# Topic souscrit par l'app : les capteurs publient sous
# supremia/data/<sensor_id>. '#' est un joker. Même règle de guillemets.
# Préférer un préfixe versionné (supremia/v1/data/#) à un préfixe large.
EXPO_PUBLIC_MQTT_TOPIC="supremia/data/#"

# --- Reliès de démonstration (développement uniquement) -----------------------
# true  : l'app génère des relevés réalistes en local au lieu de lire le broker.
#         Les écrans de supervision sont alors utilisables sans capteur ni
#         broker, et l'interface peut être présentée/développée hors ligne.
# false : l'app tente réellement de se connecter au broker (comportement
#         attendu en production).
#
# Le bandeau bleu « Données simulées » reste affiché tant que c'est actif : une
# démonstration ne doit jamais laisser croire que des mesures sont réelles.
# Passez à false dès que le broker répond.
EXPO_PUBLIC_MQTT_SIMULATE=false
